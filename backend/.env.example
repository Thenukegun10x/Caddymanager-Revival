# Server Configuration
PORT=3000
NODE_ENV=development


# Database Engine (mongodb or sqlite)
DB_ENGINE=mongodb

# MongoDB Connection
MONGODB_URI=

# SQLite Connection
SQLITE_DB_PATH=./caddymanager.sqlite

# JWT Authentication — REQUIRED, 32+ chars. Generate with: openssl rand -hex 32
# The app refuses to boot with an empty, short, or placeholder secret.
JWT_SECRET=
JWT_EXPIRATION=24h
# The SPA authenticates with the httpOnly cookie. Set true only for CLI/automation
# clients that need the raw JWT in the login response body.
ALLOW_BEARER_TOKEN=false

# First-boot admin bootstrap. In production ADMIN_PASSWORD is required when the
# users table is empty; in development a random password is generated and logged.
ADMIN_PASSWORD=

# CORS Settings
CORS_ORIGIN=http://localhost:5173

# MCP agent surface (opt-in). Disabled unless MCP_ENABLED=true.
# The endpoint is POST /api/v1/mcp and requires an API key in
# "Authorization: Bearer <key>" (JWT sessions are rejected).
MCP_ENABLED=false
# Comma-separated browser origins allowed to call MCP. Non-browser clients
# (CLI, editors, agents) send no Origin header and are unaffected. Unset means
# no browser origin may call the endpoint. Example:
# MCP_ALLOWED_ORIGIN=http://localhost:5173,http://192.168.1.20:3000
MCP_ALLOWED_ORIGIN=
# Loopback base URL the MCP layer uses to call the REST API with the caller's
# own key. Keep this on loopback; override only if PORT changed.
MCP_SELF_URL=http://127.0.0.1:3000

# Logging
LOG_LEVEL=debug

# Caddy sandbox URL
CADDY_SANDBOX_URL=http://localhost:2019

# SSRF policy: production allows private Caddy targets only by exact hostname.
ALLOW_PRIVATE_HOSTS=
# Broad opt-in is non-production/testing only and is ignored in production.
ALLOW_PRIVATE_IPS=false

# Ping Configuration
# Values are in milliseconds
PING_INTERVAL=30000
PING_TIMEOUT=2000

# Audit Logging Configuration
# Maximum size of the audit log collection in megabytes
AUDIT_LOG_MAX_SIZE_MB=100
# Number of days to retain audit logs (optional, set to 0 to disable automatic deletion)
AUDIT_LOG_RETENTION_DAYS=90
